# Imports
pytaguañemu "stdlib/core/ijykegua"
pytaguañemu "stdlib/core/sa'y"

# Fibonacci Function
japo fibo_loop(n) {
    a = 0
    b = 1
    i = 0
    aja i < n {
        he'i a
        temp = a + b
        a = b
        b = temp
        i = i + 1
    }
}

# Fibonacci Test
fibo_loop(10)


# Color Tests
he'i col("red", "red")
he'i col("blue", "blue")
he'i col("green", "green")