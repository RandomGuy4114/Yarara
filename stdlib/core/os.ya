# -------------------------------------------------------
# Yarara OS Library
# This Library makes it easier to interact
# with the operating system and perform common tasks.
# By: FormalBlaze
# -------------------------------------------------------

mbo'ehakoty osy {
    ñepyrũ() {
        che.platform = che.plataforma()
    }

    # Platform Detection Function
    plataforma() {
        # 'uname' exists on Darwin & Linux and returns "Darwin"/"Linux".
        # It doesn't exist as a cmd.exe builtin, so an empty result means
        # we're on Windows.
        resultado = okerayvu("uname")
        ramo resultado != "" {
            mbojevy resultado
        }
        mbojevy "Windows"
    }

    # Exit Function
    ñesẽha() {
        python "import sys; sys.exit()"
    }

    # Get the current user
    user() {
        # 'whoami' works the same on Darwin, Linux & Windows
        mbojevy okerayvu("whoami")
    }

    # Get the current operating system version
    version() {
        ramo che.platform == "Darwin" {
            mbojevy okerayvu("sw_vers | grep ProductVersion | awk '{print $2}'")
        } ambue ramo che.platform == "Linux" {
            mbojevy okerayvu("grep VERSION_ID= /etc/os-release | head -1 | cut -d= -f2 | tr -d '\"'")
        } ambue ramo che.platform == "Windows" {
            mbojevy okerayvu("ver")
        }
    }

    # Get the current working directory
    cwd() {
        ramo che.platform == "Windows" {
            mbojevy okerayvu("cd")
        }
        mbojevy okerayvu("pwd")
    }

    # Get the hostname of the system
    hostname() {
        # 'hostname' works the same on Darwin, Linux & Windows
        mbojevy okerayvu("hostname")
    }

    # Get the current shell
    rekoShell() {
        ramo che.platform == "Windows" {
            mbojevy okerayvu("echo %COMSPEC%")
        }
        mbojevy okerayvu("echo $SHELL")
    }

    # List of command-line arguments passed after the script's own path,
    # e.g. `yarara main.ya --foo bar` gives ["--foo", "bar"] here.
    argv() {
        mbojevy argv()
    }

    # Which shell startup file 'alias' definitions should be persisted to
    rcArchivo() {
        shell = che.rekoShell()
        ramo oguereko(shell, "zsh") {
            mbojevy "~/.zshrc"
        }
        ramo oguereko(shell, "bash") {
            mbojevy "~/.bashrc"
        }
        mbojevy "~/.profile"
    }

    setAlias(alias, command) {
        ramo che.platform == "Windows" {
            macro_archivo = "%USERPROFILE%\\yarara_doskey_macros.cmd"
            okerayvu("echo " + alias + "=" + command + " >> " + macro_archivo)
            okerayvu(
                "reg add \"HKCU\\Software\\Microsoft\\Command Processor\" /v AutoRun /d \"doskey /macrofile=" +
                macro_archivo + "\" /f"
            )
        } ambue {
            rc_archivo = che.rcArchivo()
            # A quoted heredoc ('YARARA_EOF') is appended instead of a
            # single echo line, so the shell doesn't try to expand
            # anything ($, `, \) inside 'command', and the rc file gets a
            # readable blank-line + comment + alias block.
            okerayvu(
                "cat >> " + rc_archivo + " <<'YARARA_EOF'\n" +
                "\n" +
                "# Added by Yarara\n" +
                "alias " + alias + "='" + command + "'\n" +
                "YARARA_EOF"
            )
        }
    }

    sourceShell() {
        ramo che.platform == "Windows" {
            mbojevy okerayvu("doskey /macrofile=%USERPROFILE%\\yarara_doskey_macros.cmd")
        } ambue {
            rc_archivo = che.rcArchivo()
            mbojevy okerayvu("source " + rc_archivo)
        }
    }
}

os = pyahu osy()
